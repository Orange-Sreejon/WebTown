# .kiro is intentionally NOT ignored — steering, specs and hooks belong in source control

# Raw asset source packs — licence terms prohibit redistribution as raw assets.
# These folders contain the original downloads and must not be published in a public repo.
# The game uses copies placed under public/assets/ which are part of the built application.
# See docs/ASSETS.md for full licence analysis.
TILESET VILLAGE TOP DOWN/
tiny_cast_village_folk_v1.0/

# Interior art. The three sheets the game loads at runtime (work.png, work3.png,
# work4.png) are committed: the project owner confirmed the redistribution rights,
# so a clone shows the real room instead of the placeholder.
# Everything else in this folder (insp*, work2.png, Interior1.tmx) is unverified
# reference material and stays local-only.
# See docs/ASSETS.md "Asset Pack 7".
public/assets/interior/*
!public/assets/interior/work.png
!public/assets/interior/work3.png
!public/assets/interior/work4.png

# Screenshots of the interior art (unverified licence) - never commit.
/previews/

# Local-only design references. The Paint reference screenshot is a Microsoft UI
# screenshot: development reference only, never publish or ship it. Kept outside
# public/ so Vite does not copy it into dist/.
/inspiration-art/

# S-01 sandbox spike output (findings are summarised in docs/site-sandbox-findings.md)
/spikes/site-sandbox/test-results/
/playwright-report/
/spikes/site-sandbox/findings/

# Browser test output (npm run test:e2e)
/tests/e2e/test-results/
