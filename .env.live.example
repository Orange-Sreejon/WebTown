# Live tests against a dedicated Supabase TEST project (npm run test:live). Copy to `.env.live.local` (git-ignored)
# and fill in. Never a production project.
#
# Only the project URL and the PUBLISHABLE key (Project Settings > API Keys, `sb_publishable_...`). Never the secret /
# service_role key, never the database password: the tests refuse a secret key.
WEBTOWN_LIVE=1
WEBTOWN_LIVE_SUPABASE_URL=
WEBTOWN_LIVE_SUPABASE_KEY=
