# WebTown and Supabase (Phase 4). Copy to `.env.local` and fill in; `.env*` files other than this one are git-ignored.
# Leave both empty to run WebTown on this device only (no accounts), as before Phase 4.
#
# Only the project URL and the PUBLISHABLE key (anon) belong here: both are public by design, and access is decided
# by Row Level Security in the database. Never put the secret / service_role key in any VITE_ variable: everything
# prefixed VITE_ is shipped to every browser. WebTown refuses to start with a secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=